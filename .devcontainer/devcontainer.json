{
  "name": "chaincodecamp-dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {},
  "postStartCommand": "pnpm install && pnpm run dev",
  "postCreateCommand": "pnpm install",
  "customizations": {
    "vscode": {
      "extensions": []
    },
    "ports": {
      "3000": {
