# Auth provider used by the app. Only "mock" ships today; supabase/nextauth arrive later.
NEXT_PUBLIC_AUTH_PROVIDER=mock

# Phase 2: Codespaces deep link for the Open Lab button (repo and branch).
NEXT_PUBLIC_CODESPEACES_REPO=GoodnessFx/ChainCodeCamp
NEXT_PUBLIC_CODESPEACES_BRANCH=main

# Phase 5: AI provider key. Server-side only (route handlers). Never prefix with NEXT_PUBLIC_.
# AI_API_KEY=
